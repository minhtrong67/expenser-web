rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Daily-reminder push subscriptions: one document per device, id = "<uid>_<hash>".
    // Users can only manage their own; the server reads them with the Admin SDK.
    match /reminders/{reminderId} {
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && reminderId.matches(request.auth.uid + '_.*')
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64;
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
