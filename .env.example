# Sao chép file này thành ".env" và điền thông tin Firebase project của bạn.
# Lấy tại: Firebase Console > Project Settings > General > Your apps > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Daily reminder notifications (optional) -------------------------------------
# Public VAPID key for Web Push. Generate a pair with:  npm run vapid
# Without it the reminder still works while the app is open / in the background.
VITE_VAPID_PUBLIC_KEY=

# --- Server side only (Vercel Project > Settings > Environment Variables) --------
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   (one line)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=a-long-random-string
# REMINDER_WINDOW_MINUTES=90
